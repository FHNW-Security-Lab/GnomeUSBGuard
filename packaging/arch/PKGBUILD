_pkgbuild_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
_repo_root="$(cd -- "${_pkgbuild_dir}/../.." && pwd)"
_extension_dir="${_repo_root}/extension"
_metadata_path="${_extension_dir}/metadata.json"
_uuid='usbguard-prompt@blacksheeep'

pkgname=gnome-shell-extension-usbguard-prompt
pkgver="$(
  sed -nE 's/.*"version":[[:space:]]*([0-9]+).*/\1/p' "${_metadata_path}"
)"
pkgrel=1
pkgdesc='GNOME Shell extension for interactive USBGuard authorization'
arch=('any')
url='https://github.com/FHNW-Security-Lab/GnomeUSBGuard'
license=('GPL-3.0-only')
depends=('gnome-shell>=49' 'usbguard')
install="${pkgname}.install"

package() {
  local extension_target="${pkgdir}/usr/share/gnome-shell/extensions/${_uuid}"

  install -d "${extension_target}"
  cp -r "${_extension_dir}/." "${extension_target}/"

  install -Dm644 "${_repo_root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
